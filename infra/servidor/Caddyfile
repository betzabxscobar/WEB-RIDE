# La web de Ride en ride.com.ec
# ---------------------------------------------------------------------------
# Caddy saca y renueva el certificado HTTPS solo, sin tocar nada, siempre que
# el dominio resuelva a la IP publica de este servidor y los puertos 80 y 443
# lleguen hasta aqui. Ver README.md, que es donde estan los pasos que NO se
# arreglan con este archivo.
#
# Las cabeceras de abajo son las mismas de `public/_headers`. Ese archivo lo
# leen Netlify y Cloudflare Pages; Caddy no. Estan repetidas por eso, y
# `npm run check:quality` compara las dos listas para que nadie cambie una y
# se olvide de la otra.

ride.com.ec, www.ride.com.ec {
	root * /var/www/ride
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' ws: wss: https://*.supabase.co https://router.project-osrm.org https://photon.komoot.io https://tiles.openfreemap.org; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		# Un ano de HSTS. Ojo: una vez que un navegador lo ve, se niega a entrar
		# por HTTP a este dominio durante ese ano, aunque el certificado caduque
		# o se desmonte el HTTPS. No activarlo hasta que el sitio funcione bien
		# por HTTPS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# El servidor no tiene por que anunciar que es.
		-Server
	}

	# Los archivos de `assets/` llevan un hash en el nombre: si cambia el
	# contenido, cambia el nombre. Por eso se pueden cachear para siempre.
	@estaticos path /assets/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"

	# El index NO se cachea: es lo unico que apunta a los archivos con hash, y
	# si el navegador se queda con uno viejo sigue pidiendo la version anterior
	# aunque ya se haya desplegado otra.
	@index path /index.html /
	header @index Cache-Control "no-cache"

	# Es una aplicacion de una sola pagina: cualquier ruta que no sea un archivo
	# la resuelve el propio index. Sin esto, entrar directo a una URL interna o
	# recargar da 404.
	try_files {path} /index.html
	file_server

	log {
		output file /var/log/caddy/ride-acceso.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
